{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wiatrek-kevin-s/geo-registry/schema/entry.schema.json",
  "title": "geo-registry entry",
  "description": "One entry in the Columbus geo-registry: a data source, a piece of GIS software (kind `tool`), an engine-neutral geoprocessing operation, or one engine's implementation of an operation. Entries are CC0-1.0.",
  "type": "object",
  "required": ["id", "kind", "name", "status", "review"],
  "properties": {
    "kind": { "enum": ["data", "tool", "operation", "implementation"] }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "data" } }, "required": ["kind"] },
      "then": { "$ref": "#/$defs/dataEntry" }
    },
    {
      "if": { "properties": { "kind": { "const": "tool" } }, "required": ["kind"] },
      "then": { "$ref": "#/$defs/toolEntry" }
    },
    {
      "if": { "properties": { "kind": { "const": "operation" } }, "required": ["kind"] },
      "then": { "$ref": "#/$defs/operationEntry" }
    },
    {
      "if": { "properties": { "kind": { "const": "implementation" } }, "required": ["kind"] },
      "then": { "$ref": "#/$defs/implementationEntry" }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "maxLength": 96
    },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "httpUrl": {
      "type": "string",
      "pattern": "^(https?|s3)://\\S+$"
    },
    "license": {
      "description": "SPDX licence expression, a LicenseRef-* identifier, or NOASSERTION.",
      "type": "string",
      "minLength": 1,
      "pattern": "^(NOASSERTION|[A-Za-z0-9().+ -]+)$"
    },
    "entryStatus": {
      "description": "Registry status of the entry itself (not of the upstream project).",
      "enum": ["active", "degraded", "retired"]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": { "enum": ["seeded", "reviewed"] },
        "source": { "type": "string" },
        "source_row": { "type": "integer", "minimum": 2 },
        "reviewed_by": { "type": "string" },
        "reviewed_on": { "type": "string", "format": "date" }
      },
      "if": { "properties": { "state": { "const": "seeded" } } },
      "then": { "required": ["state", "source", "source_row"] }
    },
    "operationReview": {
      "description": "Review state of an operation or implementation. `draft`: written but not yet checked by a person. `harvested`: generated from the engine's own description by the harvester named in `source`. `reviewed`: checked by a person. Data and tool entries keep the `review` states Columbus already reads.",
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": { "enum": ["draft", "harvested", "reviewed"] },
        "source": { "type": "string" },
        "reviewed_by": { "type": "string" },
        "reviewed_on": { "type": "string", "format": "date" }
      },
      "if": { "properties": { "state": { "const": "harvested" } } },
      "then": { "required": ["state", "source"] }
    },
    "relatedIds": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    },
    "accessType": {
      "enum": [
        "http", "download", "ogc-wms", "ogc-wmts", "ogc-wfs", "ogc-wcs",
        "ogc-api-features", "ogc-api-tiles", "stac", "ept", "arcgis-rest",
        "s3", "api", "other"
      ]
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "url", "auth"],
      "properties": {
        "type": { "$ref": "#/$defs/accessType" },
        "url": { "$ref": "#/$defs/httpUrl" },
        "index": {
          "description": "Optional layer/collection/index within the endpoint (layer name, collection id, EPT index path, ...).",
          "type": "string"
        },
        "auth": { "enum": ["none", "api-key", "oauth", "login"] },
        "notes": { "type": "string" }
      }
    },
    "recipeTool": {
      "description": "Columbus server tool that executes the recipe. Recipes are declarative; the server owns all code.",
      "enum": ["query_features", "vector_op", "raster_op", "pointcloud_pipeline", "registry_fetch"]
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "steps"],
      "properties": {
        "tool": { "$ref": "#/$defs/recipeTool" },
        "steps": {
          "description": "Plain-language declarative steps. Never code: no shell, no scripts, no inline programs.",
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "not": {
              "pattern": "(`|\\$\\(|&&|\\|\\||;\\s*(rm|curl|wget|sh|bash|python|powershell)\\b|\\b(import|eval|exec|subprocess|os\\.system|lambda)\\b|<script|#!/)"
            }
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region"],
      "properties": {
        "region": { "$ref": "#/$defs/nonEmptyString" },
        "bbox": {
          "description": "[minx, miny, maxx, maxy] in EPSG:4326 degrees.",
          "type": "array",
          "prefixItems": [
            { "type": "number", "minimum": -180, "maximum": 180 },
            { "type": "number", "minimum": -90, "maximum": 90 },
            { "type": "number", "minimum": -180, "maximum": 180 },
            { "type": "number", "minimum": -90, "maximum": 90 }
          ],
          "minItems": 4,
          "maxItems": 4,
          "items": false
        }
      }
    },
    "dataEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "name", "publisher", "themes", "coverage", "license", "access", "status", "review"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "data" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "summary": { "type": "string" },
        "publisher": { "$ref": "#/$defs/nonEmptyString" },
        "themes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "coverage": { "$ref": "#/$defs/coverage" },
        "license": { "$ref": "#/$defs/license" },
        "license_original": { "type": "string" },
        "update": {
          "description": "Update cadence, e.g. daily, monthly, annual, irregular, static.",
          "type": "string"
        },
        "access": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/access" }
        },
        "recipe": { "$ref": "#/$defs/recipe" },
        "formats_out": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        },
        "notes": { "type": "string" },
        "last_verified": { "type": "string", "format": "date" },
        "status": { "$ref": "#/$defs/entryStatus" },
        "replaced_by": { "$ref": "#/$defs/id" },
        "related": { "$ref": "#/$defs/relatedIds" },
        "review": { "$ref": "#/$defs/review" }
      }
    },
    "toolEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "name", "category", "tool_kind", "open_source", "license", "interfaces", "project_status", "status", "review"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "tool" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "category": { "$ref": "#/$defs/nonEmptyString" },
        "subcategory": { "type": "string" },
        "tool_kind": {
          "description": "The Geospatial Tool Atlas `kind` value.",
          "enum": ["Library", "Format/Standard", "Application", "Server", "Service/API", "Toolkit/CLI", "Extension", "Platform", "Database"]
        },
        "summary": { "type": "string" },
        "open_source": { "enum": ["yes", "no", "partial"] },
        "license": { "$ref": "#/$defs/license" },
        "license_original": { "type": "string" },
        "language": { "type": "string" },
        "interfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        },
        "install": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "winget": { "$ref": "#/$defs/nonEmptyString" },
            "conda_forge": { "$ref": "#/$defs/nonEmptyString" },
            "pip": { "$ref": "#/$defs/nonEmptyString" },
            "npm": { "$ref": "#/$defs/nonEmptyString" },
            "cargo": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        "call": {
          "description": "How an agent can call the tool.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["cli", "python", "rest", "js", "r", "sql", "mcp", "ogc", "stac", "c-cpp", "rust", "java", "dotnet", "go", "jdbc", "julia", "plugin", "download"]
          }
        },
        "wrapped_by_columbus": { "type": "boolean", "default": false },
        "project_status": { "enum": ["active", "maintained", "low-activity", "unknown", "archived"] },
        "url": { "$ref": "#/$defs/httpUrl" },
        "notes": { "type": "string" },
        "related": { "$ref": "#/$defs/relatedIds" },
        "also_categories": {
          "description": "Other atlas categories this tool also belongs to.",
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        },
        "status": { "$ref": "#/$defs/entryStatus" },
        "replaced_by": { "$ref": "#/$defs/id" },
        "review": { "$ref": "#/$defs/review" }
      }
    },
    "paramName": {
      "description": "Canonical parameter name. Where Columbus already has a name for the parameter, the operation uses it.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "maxLength": 64
    },
    "scalar": { "type": ["string", "number", "boolean"] },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "$ref": "#/$defs/paramName" },
        "type": { "enum": ["vector", "raster", "table", "pointcloud", "any"] },
        "geometry": { "enum": ["point", "line", "polygon", "any"] },
        "note": { "type": "string", "maxLength": 300 }
      }
    },
    "canonicalParam": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["length", "number", "integer", "boolean", "string", "enum", "crs", "field", "fields", "extent", "list"]
        },
        "required": { "type": "boolean" },
        "default": { "$ref": "#/$defs/scalar" },
        "values": { "type": "array", "items": { "$ref": "#/$defs/scalar" }, "minItems": 1, "uniqueItems": true },
        "unit": { "type": "string" },
        "note": { "type": "string", "maxLength": 300 }
      }
    },
    "checkId": {
      "description": "A Columbus verification check id (design set, section 4), e.g. crs.measure.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
    },
    "operationEntry": {
      "description": "An engine-neutral geoprocessing operation (Buffer, Clip, Zonal statistics). Implementations in each engine point to it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "name", "summary", "group", "inputs", "outputs", "status", "review"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "operation" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "aka": {
          "description": "Other names analysts and engines use for it (searchable).",
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        },
        "summary": { "type": "string", "minLength": 1, "maxLength": 300 },
        "group": {
          "description": "Data family and topic, e.g. vector/proximity, raster/terrain.",
          "type": "string",
          "pattern": "^(vector|raster|table|pointcloud|conversion)(/[a-z0-9-]+)?$"
        },
        "inputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/port" } },
        "outputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/port" } },
        "parameters": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/paramName" },
          "additionalProperties": { "$ref": "#/$defs/canonicalParam" }
        },
        "broader": { "$ref": "#/$defs/relatedIds" },
        "narrower": { "$ref": "#/$defs/relatedIds" },
        "related": { "$ref": "#/$defs/relatedIds" },
        "checks": {
          "description": "Verification checks that always apply to this operation, whichever engine runs it.",
          "type": "array",
          "items": { "$ref": "#/$defs/checkId" },
          "uniqueItems": true
        },
        "pitfalls": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 300 }
        },
        "columbus": {
          "description": "The Columbus server tool and op that run this operation today, in Columbus's own names.",
          "type": "object",
          "additionalProperties": false,
          "required": ["tool", "op"],
          "properties": {
            "tool": { "enum": ["vector_op", "raster_op", "pointcloud_pipeline"] },
            "op": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
          }
        },
        "notes": { "type": "string" },
        "status": { "$ref": "#/$defs/entryStatus" },
        "replaced_by": { "$ref": "#/$defs/id" },
        "review": { "$ref": "#/$defs/operationReview" }
      }
    },
    "engineParam": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "$ref": "#/$defs/nonEmptyString" },
        "required": { "type": "boolean" },
        "default": { "$ref": "#/$defs/scalar" },
        "values": { "type": "array", "items": { "$ref": "#/$defs/scalar" }, "uniqueItems": true },
        "units": { "type": "string" },
        "note": { "type": "string", "maxLength": 300 }
      }
    },
    "crosswalkItem": {
      "description": "How a canonical parameter maps onto the engine: the engine parameter's name, or a mapping with value translation and the canonical values the engine cannot honour.",
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "param": { "type": "string", "minLength": 1 },
            "values": { "type": "object", "additionalProperties": { "$ref": "#/$defs/scalar" } },
            "unsupported": { "type": "array", "items": { "$ref": "#/$defs/scalar" }, "uniqueItems": true }
          }
        }
      ]
    },
    "implementationEntry": {
      "description": "One callable in one engine (arcpy.analysis.Buffer, QGIS native:buffer, PostGIS ST_Buffer). Parameters come from the engine's own description via a harvester; implements, crosswalk, differences and effects are written by people.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "name", "software", "call", "parameters", "status", "review"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "implementation" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "software": { "$ref": "#/$defs/id" },
        "implements": { "$ref": "#/$defs/id" },
        "call": {
          "type": "object",
          "additionalProperties": false,
          "required": ["interface", "name"],
          "properties": {
            "interface": { "enum": ["python", "cli", "qgis-process", "sql", "rest", "r", "js", "java", "dotnet", "other"] },
            "name": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        "harvest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["harvester", "engine_version"],
          "properties": {
            "harvester": { "$ref": "#/$defs/nonEmptyString" },
            "engine_version": { "$ref": "#/$defs/nonEmptyString" },
            "harvested_on": { "type": "string", "format": "date" }
          }
        },
        "parameters": {
          "type": "object",
          "propertyNames": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]*$" },
          "additionalProperties": { "$ref": "#/$defs/engineParam" }
        },
        "crosswalk": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/paramName" },
          "additionalProperties": { "$ref": "#/$defs/crosswalkItem" }
        },
        "differences": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 300 }
        },
        "effects": {
          "description": "What the tool does beyond writing its output. These flags can only make the Columbus server stricter, never looser.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "modifies_input": { "type": "boolean" },
            "writes_outside_output": { "type": "boolean" },
            "network": { "type": "boolean" }
          }
        },
        "requires": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "licence": { "type": "string" },
            "extension": { "type": "string" },
            "note": { "type": "string" }
          }
        },
        "docs": { "$ref": "#/$defs/httpUrl" },
        "notes": { "type": "string" },
        "status": { "$ref": "#/$defs/entryStatus" },
        "replaced_by": { "$ref": "#/$defs/id" },
        "review": { "$ref": "#/$defs/operationReview" }
      }
    }
  }
}
