---
import Base from "../layouts/Base.astro";
import { loadRegistry } from "../lib/registry";
import { href } from "../lib/paths";
import { fmtCount } from "../lib/text";
import { dataGroups } from "../lib/browse";

const reg = loadRegistry();
const data = reg.cards.filter((c) => c.kind === "data");
const tools = reg.cards.filter((c) => c.kind === "tool");
const reviewed = data.filter((c) => c.review === "reviewed").length;
const themeCounts = new Map<string, number>();
for (const c of data) {
  for (const t of (c.themes as string[] | undefined) ?? []) {
    themeCounts.set(t, (themeCounts.get(t) ?? 0) + 1);
  }
}
const themes = [...themeCounts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 12);
---

<Base
  title="geo-registry: GIS data sources, tools and how each engine runs an operation"
  description="Find what data covers a place, which tool does a job, and how each GIS engine runs an operation."
  section="home"
  hideHeaderSearch
>
  <h1>geo-registry</h1>
  <p class="summary">
    Find what data covers a place, which tool does a job, and how each GIS engine runs an operation.
  </p>

  <form class="search-form" role="search" action={href("search/")} method="get">
    <label for="home-q">Search data sources, tools and operations</label>
    <div class="search-row">
      <input id="home-q" name="q" type="search" autocomplete="off" />
      <button type="submit" class="button-primary">
        Search
      </button>
    </div>
    <p class="muted hint">Try “lidar Travis County”, “buffer PostGIS” or “zonal statistics”.</p>
  </form>

  <ul class="counts" aria-label="What the registry holds">
    <li>
      <strong>{fmtCount(data.length)}</strong>
      <a href={href("data/")}>data sources</a>
    </li>
    <li>
      <strong>{fmtCount(tools.length)}</strong>
      <a href={href("tools/")}>tools</a>
    </li>
    <li>
      <strong>{fmtCount(reg.operations.length)}</strong>
      <a href={href("operations/")}>operations</a>
    </li>
    <li>
      <strong>{fmtCount(reg.implementations.length)}</strong>
      <a href={href("engines/")}>engine implementations</a>
    </li>
  </ul>

  <p>
    <strong>Reviewed or unverified?</strong>
    {fmtCount(reviewed)} of {fmtCount(data.length)} data sources have been reviewed by a person. The
    rest are <em>seeded</em>: unverified leads from the seed atlas, worth checking before you rely
    on them.
  </p>

  <h2>Browse</h2>
  <h3>By region</h3>
  <ul class="inline" data-browse="region">
    {dataGroups().map((g) => (
      <li>
        <a href={href(`data/#${g.anchor}`)}>{g.label}</a>
      </li>
    ))}
  </ul>
  <h3>By theme</h3>
  <ul class="inline" data-browse="theme">
    {themes.map(([t]) => (
      <li>
        <a href={href(`search/?theme=${encodeURIComponent(t)}`)}>{t}</a>
      </li>
    ))}
  </ul>

  <p>
    Using an AI app? See the <a href={href("ai/")}>AI skill and connector</a>.
  </p>
</Base>
