---
// A dense, static list of entries of one kind, ordered by name.
import Badge from "./Badge.astro";
import Value from "./Value.astro";
import { entryPath } from "../lib/paths";
import type { Card } from "../lib/registry";
interface Props {
  cards: Card[];
  kind: "data" | "tool" | "operation";
  extra: { label: string; key: string };
}
const { cards, kind, extra } = Astro.props;
---

<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th scope="col">Name</th>
        <th scope="col">{extra.label}</th>
        <th scope="col">Summary</th>
        <th scope="col">Review</th>
      </tr>
    </thead>
    <tbody>
      {cards.map((c) => (
        <tr>
          <th scope="row">
            <a href={entryPath(kind, c.id)}>{c.name}</a>
            {c.status === "retired" && (
              <>
                {" "}
                <span class="badge badge-retired">Retired</span>
              </>
            )}
          </th>
          <td>
            <Value value={c[extra.key]} />
          </td>
          <td>
            <Value value={c.summary} />
          </td>
          <td>
            <Badge review={c.review} />
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
