---
import "../styles/tokens.css";
import "../styles/site.css";
import { loadRegistry } from "../lib/registry";
import Sidebar from "../components/Sidebar.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import type { SectionNav } from "../lib/browse";
import { href, REPO } from "../lib/paths";

interface Props {
  title: string;
  description?: string;
  section?: "home" | "data" | "tools" | "operations" | "engines" | "contribute";
  sidebar?: SectionNav;
  noindex?: boolean;
  noCanonical?: boolean;
  hideHeaderSearch?: boolean;
}
const {
  title,
  description,
  section,
  sidebar,
  noindex = false,
  noCanonical = false,
  hideHeaderSearch = false,
} = Astro.props;
const reg = loadRegistry();
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const nav = [
  { key: "data", label: "Data", path: "data/" },
  { key: "tools", label: "Tools", path: "tools/" },
  { key: "operations", label: "Operations", path: "operations/" },
  { key: "engines", label: "Engines", path: "engines/" },
  { key: "contribute", label: "Contribute", path: "contribute/" },
] as const;
// Public token from the repo variable CF_BEACON_TOKEN; with none, no analytics at all.
const beaconToken = process.env.CF_BEACON_TOKEN;
const fullTitle = section === "home" ? title : `${title} · geo-registry`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Set the saved theme before the first paint, so a page never flashes the wrong one.
      (function () {
        const root = document.documentElement;
        root.classList.add("js");
        try {
          const saved = localStorage.getItem("theme");
          if (saved === "dark" || saved === "light") root.dataset.theme = saved;
        } catch {
          // Storage can be blocked; the device setting still applies.
        }
      })();
    </script>
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    {!noCanonical && <link rel="canonical" href={canonical} />}
    <link
      rel="preload"
      href={href("fonts/IBMPlexSans-Regular.woff2")}
      as="font"
      type="font/woff2"
      crossorigin
    />
    {beaconToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: beaconToken })}
      />
    )}
  </head>
  <body>
    <a class="skip-link" href="#content">
      Skip to content
    </a>
    <header class="topbar">
      <div class="topbar-inner">
        <a class="site-name" href={href()}>
          geo-registry
        </a>
        {!hideHeaderSearch && (
          <form class="header-search" role="search" action={href("search/")} method="get">
            <label for="header-q" class="visually-hidden">
              Search the registry
            </label>
            <input id="header-q" name="q" type="search" placeholder="Search" />
            <button type="submit" class="button-secondary">
              Search
            </button>
          </form>
        )}
        <nav class="main-nav" aria-label="Main">
          <ul>
            {nav.map((n) => (
              <li>
                <a href={href(n.path)} aria-current={section === n.key ? "true" : undefined}>
                  {n.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <ThemeToggle />
      </div>
    </header>
    <div class={sidebar ? "layout layout-sidebar" : "layout"}>
      {sidebar && <Sidebar nav={sidebar} />}
      <main id="content" class="page" tabindex="-1">
        <slot />
      </main>
    </div>
    <footer class="footer">
      <div class="footer-inner">
        <p>
          Built from registry commit <code data-registry-commit>{reg.commit}</code>, index generated
          <time datetime={reg.generatedAt} data-generated-at>
            {reg.generatedAt}
          </time>
        </p>
        <p>
          Entries CC0-1.0, code Apache-2.0; each publisher's own terms apply to its data.
          <a href={REPO}>Source on GitHub</a>.
        </p>
        <p>
          <a href={href("about/")}>About and privacy</a> ·
          <a href={href("ai/")}>AI skill and connector</a>
        </p>
      </div>
    </footer>
    <script>
      // A table that scrolls sideways must be reachable by keyboard (WCAG 2.1.1).
      function markScrollable() {
        for (const box of document.querySelectorAll<HTMLElement>(".table-wrap")) {
          if (box.scrollWidth > box.clientWidth) {
            box.tabIndex = 0;
            box.setAttribute("role", "region");
            box.setAttribute("aria-label", "Table, scrolls sideways");
          } else {
            box.removeAttribute("tabindex");
            box.removeAttribute("role");
            box.removeAttribute("aria-label");
          }
        }
      }
      markScrollable();
      addEventListener("resize", markScrollable);
    </script>
  </body>
</html>
